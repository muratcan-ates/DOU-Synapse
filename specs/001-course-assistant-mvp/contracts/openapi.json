  "components": {
    "schemas": {
      "AnswerStatus": {
        "type": "string",
        "enum": [
          "answered",
          "insufficient_context",
          "out_of_scope"
        ],
        "title": "AnswerStatus",
        "description": "Cevabın üç meşru sonucu. İkisi 'cevap yok' ama SEBEPLERİ farklı.\n\nKarıştırılmamalı: `insufficient_context` \"materyalde var olabilir ama kanıt\nzayıf\", `out_of_scope` \"bu ders bu konuyu hiç kapsamıyor\". Kullanıcıya\nverilen metin de ölçüm kategorisi de farklıdır (SC-005 yalnız ikincisini ölçer)."
      },
      "Body_upload_document_courses__course_id__documents_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "PDF, PPTX, Markdown, metin veya kod dosyası"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_document_courses__course_id__documents_post"
      },
      "ChatMessageOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "role": {
            "$ref": "#/components/schemas/ChatRole"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/CitationOut"
            },
            "type": "array",
            "title": "Citations"
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AnswerStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "socratic_stage": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SocraticStage"
              },
              {
