{
  "schema_version": 1,
  "dossier_schema": ".ai/schema.json",
  "dossier_glob": ".ai/changes/*.json",
  "risk_order": {
    "R1": 1,
    "R2": 2,
    "R3": 3
  },
  "allowed_evidence_labels": [
    "fake-provider",
    "offline-replay",
    "real-provider",
    "staging",
    "canary",
    "production",
    "rollback"
  ],
  "allowed_statuses": [
    "draft",
    "evidence-ready",
    "awaiting-approval",
    "canary",
    "expanded",
    "rolled-back",
    "closed"
  ],
  "risk_requirements": {
    "R1": {
      "required_approval_roles": [
        "peer"
      ],
      "require_independent_approval": true,
      "require_feature_flag": false,
      "require_kill_switch": true,
      "require_sticky_assignment": false
    },
    "R2": {
      "required_approval_roles": [
        "engineering",
        "course_or_product"
      ],
      "require_independent_approval": true,
      "require_feature_flag": true,
      "require_kill_switch": true,
      "require_sticky_assignment": true
    },
    "R3": {
      "required_approval_roles": [
        "engineering",
        "domain",
        "security_or_privacy"
      ],
      "require_independent_approval": true,
      "require_feature_flag": true,
      "require_kill_switch": true,
      "require_sticky_assignment": true
    }
  },
  "privacy": {
    "allow_identifiable_student_content": false
  },
  "production_claim": {
    "required_passing_labels": [
      "real-provider"
    ],
    "required_environment_labels_any_of": [
      "staging",
      "canary",
      "production"
    ],
    "minimum_named_human_approval_refs": 2
  },
  "sensitive_paths": [
    {
      "pattern": ".ai/changes/**",
      "minimum_risk": "R3"
    },
    {
      "pattern": ".ai/evidence/**",
      "minimum_risk": "R3"
    },
    {
      "pattern": ".ai/quarantine/**",
      "minimum_risk": "R3"
    },
    {
      "pattern": ".ai/policy.json",
      "minimum_risk": "R3"
    },
    {
      "pattern": ".ai/schema.json",
      "minimum_risk": "R3"
    },
    {
      "pattern": ".ai/README.md",
      "minimum_risk": "R3"
    },
    {
      "pattern": "scripts/ai_sdlc_check.py",
      "minimum_risk": "R3"
    },
    {
      "pattern": "scripts/test_ai_sdlc_check.py",
      "minimum_risk": "R3"
    },
    {
      "pattern": ".github/workflows/ai-quality.yml",
      "minimum_risk": "R3"
    },
    {
      "pattern": "apps/api/app/modules/generation/**",
      "minimum_risk": "R2"
    },
    {
      "pattern": "apps/api/app/api/chat.py",
      "minimum_risk": "R3"
    },
    {
      "pattern": "apps/api/app/api/policy.py",
      "minimum_risk": "R3"
    },
    {
      "pattern": "apps/api/app/api/blueprints.py",
      "minimum_risk": "R3"
    },
    {
      "pattern": "apps/api/app/modules/policy/**",
      "minimum_risk": "R3"
    },
    {
      "pattern": "apps/api/app/modules/retrieval/**",
      "minimum_risk": "R2"
    },
    {
      "pattern": "apps/api/app/modules/guardrails/**",
      "minimum_risk": "R3"
    },
