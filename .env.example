# DOU-Synapse ortam değişkenleri.
# Bu dosyayı `.env` olarak kopyalayıp doldurun. GERÇEK DEĞERLERİ ASLA COMMIT ETMEYİN.

# --- Ortam ------------------------------------------------------------------
# local | demo | production
ENVIRONMENT=local

# --- Veritabanı --------------------------------------------------------------
# API yalnız `dou_api_runtime` LOGIN'iyle bağlanır. Bu rol tablo sahibi değildir,
# BYPASSRLS taşımaz ve hassas assessment yetkileri session_user kimliğine bağlıdır.
# Superuser veya ortak `dou_app` taşıyıcısını bağlantı rolü olarak kullanmayın.
DATABASE_URL=postgresql+psycopg://dou_api_runtime:dou_api_runtime_local@localhost:5432/dou_synapse

# Worker, chunks tablosuna yazabilmek için RLS'i atlayan ayrı rolle bağlanır.
WORKER_DATABASE_URL=postgresql+psycopg://dou_worker:dou_worker_local@localhost:5432/dou_synapse

# --- API gozlemlenebilirligi -------------------------------------------------
# Varsayilan kapali: bu bayrak true olmadan olay kuyrugu/yazicisi acilmaz.
# Süresi dolan mevcut satırları bounded silen tek bağlantılı bakım görevi,
# kill-switch açıkken de disk saklama sınırını korumak için çalışır.
API_OBSERVABILITY_ENABLED=false
# Yalniz iceriksiz olaylar tutulur; 1..30 gun. Production'da kolektor aciksa bu
# karar ortamda acikca verilmelidir.
API_EVENT_RETENTION_DAYS=7
# CI/deploy tarafindan git SHA ya da guvenli surum etiketiyle degistirilir.
RELEASE_REVISION=unknown
# Belirtilmezse local/demo icin dokuman acik, production icin kapali cozulur.
# Production'da true vermek ayar dogrulamasinda reddedilir.
# API_DOCS_ENABLED=true

# --- Kimlik doğrulama --------------------------------------------------------
# Supabase → Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=

# Beklenen `iss` claim'i — Supabase proje URL'niz + /auth/v1
# ör. https://abcdefgh.supabase.co/auth/v1
# BOŞ BIRAKILIRSA issuer doğrulanmaz; o zaman BAŞKA bir Supabase projesinin
# token'ı da kabul edilir. Üretimde mutlaka doldurun.
SUPABASE_JWT_ISSUER=

# Yerel geliştirme ve çevrimdışı demo için imzasız `Bearer dev:<uuid>` kimlikleri.
# ENVIRONMENT=production iken açılırsa uygulama başlamaz.
DEV_AUTH_ENABLED=true

# --- CORS --------------------------------------------------------------------
# 3000 = geliştirme sunucusu, 3100 = uçtan uca test sunucusu
CORS_ORIGINS=["http://localhost:3000","http://localhost:3100"]

# --- Yükleme ve kalıcı belge deposu ------------------------------------------
MAX_UPLOAD_BYTES=20971520

# local = çevrimdışı geliştirme/demoda ./storage
# supabase = production'da kalıcı özel bucket. Production local diski reddeder.
STORAGE_BACKEND=local
STORAGE_ROOT=./storage

# STORAGE_BACKEND=supabase olduğunda üçü de sunucu tarafında kullanılır.
# Service-role anahtarını NEXT_PUBLIC_* değişkenine ASLA koymayın.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=course-materials
STORAGE_TIMEOUT_SECONDS=30

# --- Embedding ---------------------------------------------------------------
# DİKKAT: Bu ayar ingest zamanına aittir. Değiştirmek vektör uzayını değiştirir ve
# tüm korpusun yeniden işlenmesini gerektirir; çalışma zamanı yedeği DEĞİLDİR.
# hashing  = deterministik yerel sağlayıcı (test, çevrimdışı geliştirme)
# fastembed = intfloat/multilingual-e5-large, ONNX üzerinde CPU (üretim)
#
# Varsayılan bilerek `hashing`: testler ve CI 2 GB model indirmemeli, ve testler
# kendi veritabanını kendi ingest'iyle kurduğu için sağlayıcı ne olursa olsun
# TUTARLIDIR (ingest ve sorgu aynı uzayda).
#
# AMA paylaşılan `dou_synapse` geliştirme veritabanı **fastembed (E5) uzayında**
# (9 Ağustos'ta yeniden embed edildi). Ona karşı bir SUNUCU koştururken sağlayıcıyı
# açıkça ver, yoksa sorgu hashing vektörüyle korpus E5 vektörüyle karşılaşır:
#
#   EMBEDDING_PROVIDER=fastembed uv run uvicorn app.main:app --port 8000
#
# Bu uyuşmazlık ÇÖKMEZ, sessizce alakasız sonuç döndürür.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_BATCH_SIZE=32

# --- LLM (Faz B) -------------------------------------------------------------
# Sağlayıcı sırası: birincisi denenir, hata/kota durumunda ikincisine OTOMATİK düşülür.
# Failover kod seviyesindedir; sunum sırasında elle model değiştirmek gerekmez.
LLM_PRIMARY_MODEL=groq/llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=gemini/gemini-2.0-flash

# Anahtarlar boş bırakılabilir: ikisi de yoksa sistem deterministik sahte
# sağlayıcıya düşer (CI ve çevrimdışı demo bunun üzerinde koşar).
# Groq   → https://console.groq.com/keys
# Gemini → https://aistudio.google.com/apikey
GROQ_API_KEY=
GEMINI_API_KEY=

# Zaman aşımı SERT bir sınırdır: asılı kalan bir istek öğrenciyi sınav sırasında
# bekletir (SC-010 p95 < 10 sn). Deneme başına uygulanır; toplam bütçe sağlayıcı
# sayısıyla çarpılır, yani en kötü durum 2 x bu değerdir.
LLM_TIMEOUT_SECONDS=30
# Sonsuz retry ücretsiz katmanda günlük kotayı bir sabahta tüketir.
LLM_MAX_RETRIES=1
LLM_TEMPERATURE=0.2
# Sağlayıcıya giden cevap için sert üst sınır; birincil ve yedek model aynısını alır.
LLM_CHAT_MAX_TOKENS=700
# Sistem mesajı + soru + kaynak bağlamının UTF-8 byte üst sınırı. Kaynaklar bu
# sınıra sığacak şekilde sunucu tarafında kesilir; kota aynı üst sınırı ayırır.
LLM_CHAT_MAX_INPUT_BYTES=8000

# Tüm derslerden bağımsız operasyonel kapatma anahtarı. false iken asistan LLM,
# oturum, önbellek veya kota kaydı üretmeden deterministik 503 döner.
COURSE_AGENT_ENABLED=true
# Resmî sınav akışı insan onayı ve staging kanıtı olmadan açılmaz.
ASSESSMENT_BLUEPRINT_ENABLED=false
COURSE_AGENT_STUDENT_DAILY_HARD_LIMIT=50000
COURSE_AGENT_INSTRUCTOR_DAILY_HARD_LIMIT=200000
COURSE_AGENT_COURSE_DAILY_HARD_LIMIT=500000
COURSE_AGENT_PLATFORM_DAILY_HARD_LIMIT=5000000

# Deterministik sahte sağlayıcı: ağsız test ve çevrimdışı demo (PLAN plan C) içindir.
# ENVIRONMENT=production iken açılırsa uygulama BAŞLAMAZ — gerçek öğrenciye
# uydurulmuş cevap gitmesindense hiç açılmaması yeğdir.
LLM_FAKE_PROVIDER=false

# --- Soru üretimi sınırları (002) -------------------------------------------
# Sohbet sınırının kopyası DEĞİL: tek çağrı 20 soruya kadar üretiyor ve her soru
# ayrı bir LLM turu, yani maliyet profili sohbetten bir mertebe farklı.
# Eşzamanlılık sınırı maliyet için değil tutarlılık için: aynı konuya iki taslak
# kümesi yazılırsa öğretmen hangisinin hangi istekten geldiğini ayıramaz.
QUESTION_GEN_RATE_LIMIT_REQUESTS=5
QUESTION_GEN_RATE_LIMIT_WINDOW_SECONDS=300
QUESTION_GEN_MAX_CONCURRENT=1

# --- Embedding ısıtma (002) --------------------------------------------------
# Açıkken model uygulama başlarken arka planda yüklenir; ilk gerçek istek soğuk
# başlangıç cezasını tek başına ödemez. Başlatmayı BLOKLAMAZ, hazırlık readiness
# ucundan bildirilir. Testte kapalı tutun: 2,1 GB'lık model her koşuda yüklenmez.
EMBEDDING_WARMUP_ENABLED=true

# --- Değerlendirme koşuları (Faz F) -----------------------------------------
# Ölçüm koşularının LLM anahtarı. Üretim anahtarından AYRI: bir ölçüm koşusu
# üretim kotasını tüketmemeli, üretim de ölçüm sonucunu etkilememeli.
EVAL_LLM_API_KEY=

# --- Worker tetiği (Faz G) --------------------------------------------------
# `POST /internal/drain` ucunu koruyan paylaşılan sır. BOŞ BIRAKILIRSA uç kapalıdır
# (fail-closed). Üretimde uzun ve rastgele bir değer verin.
WORKER_DRAIN_SECRET=

# Ayrı bir worker servisinin drain ucu. Tanımlıysa yükleme tetiği oraya HTTP
# çağrısı yapar; boşsa süreç içi drain koşar (yerelde tek süreç, bulutta ayrı servis).
WORKER_DRAIN_URL=

# --- Embedding önbelleği (DEMO GÜNÜ İÇİN KRİTİK) -----------------------------
# fastembed modeli (2,1 GB) varsayılan olarak $TMPDIR altına iner ve macOS o dizini
# periyodik olarak TEMİZLER. Silinmişse model demo sabahı yeniden inmek zorunda kalır;
# hotspot'ta bu pratikte imkânsız. Kalıcı bir dizin verin ve boyutu T-60'ta doğrulayın.
# ör. EMBEDDING_CACHE_DIR=/Users/<siz>/.cache/dou-synapse/fastembed
EMBEDDING_CACHE_DIR=
